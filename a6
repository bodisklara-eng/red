<html lang="hu"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <title>Egydimenziós Tömbök Algoritmusai - Interaktív Gyűjtemény</title>
    <style>
        body { font-family: 'Inter', sans-serif; background: #0f172a; color: #f8fafc; padding: 20px; margin: 0; }
        .container { max-width: 1200px; margin: 0 auto; }
        header { text-align: center; margin-bottom: 40px; }
        header h1 { color: #38bdf8; font-size: 2.2rem; margin-bottom: 10px; }
        header p { color: #94a3b8; font-size: 1rem; }
        .project-card { background: #1e293b; padding: 24px; border-radius: 12px; margin-bottom: 30px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); border: 1px solid #334155; }
        .project-title { color: #f59e0b; font-size: 1.4rem; margin-top: 0; margin-bottom: 15px; border-bottom: 2px solid #334155; padding-bottom: 10px; }
        .grid-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
        @media (max-width: 900px) { .grid-layout { grid-template-columns: 1fr; } }
        
        .array-box { display: flex; gap: 8px; margin: 15px 0; overflow-x: auto; min-height: 50px; align-items: center; }
        .cell { width: 42px; height: 42px; background: #0f172a; border: 2px solid #334155; border-radius: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: monospace; font-weight: bold; font-size: 0.85rem; position: relative; }
        .cell-idx { position: absolute; bottom: -15px; font-size: 0.6rem; color: #64748b; }
        
        .controls { display: flex; gap: 8px; margin-bottom: 15px; flex-wrap: wrap; align-items: center; }
        input, button { padding: 8px 12px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: #fff; font-family: inherit; font-size: 0.9rem; }
        button { background: #0ea5e9; border: none; cursor: pointer; font-weight: 600; transition: background 0.2s; }
        button:hover { background: #0284c7; }
        
        .log { background: #090d16; padding: 10px; border-radius: 6px; font-family: monospace; font-size: 0.85rem; color: #38bdf8; min-height: 35px; margin-top: 10px; }
        
        pre.python-code { background: #05080f; padding: 12px; border-radius: 8px; border: 1px solid #223354; font-family: 'Fira Code', monospace; font-size: 0.75rem; color: #cbd5e1; overflow-x: auto; margin: 0 0 15px 0; }
        h4 { color: #38bdf8; font-size: 0.95rem; margin: 0 0 8px 0; }
        
        .cell.max { border-color: #10b981; background: rgba(16, 185, 129, 0.2); }
        .cell.min { border-color: #f43f5e; background: rgba(244, 63, 94, 0.2); }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Egydimenziós Tömbök Algoritmusai</h1>
        <p>Interaktív vizuális szimulációk + Moduláris és Iteratív Python kódok egy helyen</p>
    </header>

    <!-- 1. PROJEKT -->
    <div class="project-card">
        <h2 class="project-title">1. Projekt: Dinamikus Beszúrás és Törlés</h2>
        <div class="grid-layout">
            <div>
                <p>Elem eltolása és beszúrása index alapján.</p>
                <div class="controls">
                    <input type="number" id="v1" value="99" style="width: 60px;" placeholder="Érték">
                    <input type="number" id="i1" value="2" style="width: 60px;" placeholder="Index">
                    <button onclick="p1Insert()">Beszúrás</button>
                    <button onclick="p1Delete()" style="background: #f43f5e;">Törlés</button>
                    <button onclick="p1Reset()" style="background: #475569;">Alap</button>
                </div>
                <div class="array-box" id="arr1"><div class="cell">10<span class="cell-idx">[0]</span></div><div class="cell">20<span class="cell-idx">[1]</span></div><div class="cell">30<span class="cell-idx">[2]</span></div><div class="cell">40<span class="cell-idx">[3]</span></div><div class="cell">50<span class="cell-idx">[4]</span></div></div>
                <div class="log" id="log1">Állapot: Készenlétben.</div>
            </div>
            <div>
                <h4>Moduláris / Beépített Python:</h4>
                <pre class="python-code"><code>tomb = [10, 20, 30, 40, 50]
tomb.insert(2, 99) # Beszúrás
tomb.pop(3)        # Törlés index alapján</code></pre>
                <h4>Tiszta Iteratív Python:</h4>
                <pre class="python-code"><code>tomb = [10, 20, 30, 40, 50]
# Beszúrás kézi eltolással
tomb.append(0)
i = len(tomb) - 1
while i &gt; 2:
    tomb[i] = tomb[i - 1]
    i -= 1
tomb[2] = 99</code></pre>
            </div>
        </div>
    </div>

    <!-- 2. PROJEKT -->
    <div class="project-card">
        <h2 class="project-title">2. Projekt: Maximum- és Minimumkiválasztás</h2>
        <div class="grid-layout">
            <div>
                <p>Szélsőértékek megkeresése a tömbben.</p>
                <div class="controls">
                    <button onclick="p2Run()">Keresés Indítása</button>
                </div>
                <div class="array-box" id="arr2"><div class="cell">42<span class="cell-idx">[0]</span></div><div class="cell">15<span class="cell-idx">[1]</span></div><div class="cell">88<span class="cell-idx">[2]</span></div><div class="cell">4<span class="cell-idx">[3]</span></div><div class="cell">23<span class="cell-idx">[4]</span></div><div class="cell">91<span class="cell-idx">[5]</span></div><div class="cell">55<span class="cell-idx">[6]</span></div><div class="cell">12<span class="cell-idx">[7]</span></div></div>
                <div class="log" id="log2">Kattints a keresésre...</div>
            </div>
            <div>
                <h4>Moduláris / Beépített Python:</h4>
                <pre class="python-code"><code>tomb = [42, 15, 88, 4, 23, 91, 55, 12]
max_v = max(tomb)
min_v = min(tomb)</code></pre>
                <h4>Tiszta Iteratív Python:</h4>
                <pre class="python-code"><code>tomb = [42, 15, 88, 4, 23, 91, 55, 12]
max_v, min_v = tomb[0], tomb[0]
i = 1
while i &lt; len(tomb):
    if tomb[i] &gt; max_v: max_v = tomb[i]
    if tomb[i] &lt; min_v: min_v = tomb[i]
    i += 1</code></pre>
            </div>
        </div>
    </div>

    <!-- 3. PROJEKT -->
    <div class="project-card">
        <h2 class="project-title">3. Projekt: Statisztika (Összeg, Átlag, Szűrés)</h2>
        <div class="grid-layout">
            <div>
                <p>Elemek összegzése és feltételes megszámlálása.</p>
                <div class="controls">
                    <label>Küszöb:</label>
                    <input type="number" id="th3" value="30" style="width: 60px;">
                    <button onclick="p3Run()">Számítás</button>
                </div>
                <div class="array-box" id="arr3"><div class="cell">12<span class="cell-idx">[0]</span></div><div class="cell">45<span class="cell-idx">[1]</span></div><div class="cell">23<span class="cell-idx">[2]</span></div><div class="cell">67<span class="cell-idx">[3]</span></div><div class="cell">89<span class="cell-idx">[4]</span></div><div class="cell">10<span class="cell-idx">[5]</span></div><div class="cell">34<span class="cell-idx">[6]</span></div><div class="cell">56<span class="cell-idx">[7]</span></div></div>
                <div class="log" id="log3">Összeg: 336 | Átlag: 42.0 | Küszöb felett: 5 db</div>
            </div>
            <div>
                <h4>Moduláris / Beépített Python:</h4>
                <pre class="python-code"><code>tomb = [12, 45, 23, 67, 89, 10, 34, 56]
osszeg = sum(tomb)
atlag = osszeg / len(tomb)
szurt = len([x for x in tomb if x &gt; 30])</code></pre>
                <h4>Tiszta Iteratív Python:</h4>
                <pre class="python-code"><code>tomb = [12, 45, 23, 67, 89, 10, 34, 56]
osszeg, darab, i = 0, 0, 0
while i &lt; len(tomb):
    osszeg += tomb[i]
    if tomb[i] &gt; 30: darab += 1
    i += 1</code></pre>
            </div>
        </div>
    </div>

    <!-- 4. PROJEKT -->
    <div class="project-card">
        <h2 class="project-title">4. Projekt: Tömb Megfordítása (In-place)</h2>
        <div class="grid-layout">
            <div>
                <p>Sorrend megfordítása kétmutatós módszerrel.</p>
                <div class="controls">
                    <button onclick="p4Run()">Megfordítás</button>
                    <button onclick="p4Reset()" style="background: #475569;">Visszaállít</button>
                </div>
                <div class="array-box" id="arr4"><div class="cell">1<span class="cell-idx">[0]</span></div><div class="cell">2<span class="cell-idx">[1]</span></div><div class="cell">3<span class="cell-idx">[2]</span></div><div class="cell">4<span class="cell-idx">[3]</span></div><div class="cell">5<span class="cell-idx">[4]</span></div><div class="cell">6<span class="cell-idx">[5]</span></div><div class="cell">7<span class="cell-idx">[6]</span></div></div>
                <div class="log" id="log4">Eredeti sorrend.</div>
            </div>
            <div>
                <h4>Moduláris / Beépített Python:</h4>
                <pre class="python-code"><code>tomb = [1, 2, 3, 4, 5, 6, 7]
forditott = tomb[::-1] # Szeletelés</code></pre>
                <h4>Tiszta Iteratív Python:</h4>
                <pre class="python-code"><code>tomb = [1, 2, 3, 4, 5, 6, 7]
bal, jobb = 0, len(tomb) - 1
while bal &lt; jobb:
    tomb[bal], tomb[jobb] = tomb[jobb], tomb[bal]
    bal += 1; jobb -= 1</code></pre>
            </div>
        </div>
    </div>

</div>

<script>
    // --- 1. PROJEKT LOGIKA ---
    let data1 = [10, 20, 30, 40, 50];
    function render1() {
        const box = document.getElementById('arr1');
        box.innerHTML = data1.map((v, i) => `<div class="cell">${v}<span class="cell-idx">[${i}]</span></div>`).join('');
    }
    function p1Insert() {
        let v = parseInt(document.getElementById('v1').value), i = parseInt(document.getElementById('i1').value);
        if (isNaN(i) || i < 0 || i > data1.length) return alert('Hibás index!');
        data1.splice(i, 0, v); render1();
        document.getElementById('log1').textContent = `Siker: ${v} beszúrva ide: [${i}].`;
    }
    function p1Delete() {
        let i = parseInt(document.getElementById('i1').value);
        if (isNaN(i) || i < 0 || i >= data1.length) return alert('Hibás index!');
        let rem = data1.splice(i, 1); render1();
        document.getElementById('log1').textContent = `Siker: ${rem[0]} törölve innen: [${i}].`;
    }
    function p1Reset() { data1 = [10, 20, 30, 40, 50]; render1(); document.getElementById('log1').textContent = 'Alapállapot visszaállítva.'; }
    render1();

    // --- 2. PROJEKT LOGIKA ---
    const data2 = [42, 15, 88, 4, 23, 91, 55, 12];
    function render2(maxIdx = -1, minIdx = -1) {
        const box = document.getElementById('arr2');
        box.innerHTML = data2.map((v, i) => {
            let cls = 'cell';
            if (i === maxIdx) cls += ' max';
            if (i === minIdx) cls += ' min';
            return `<div class="${cls}">${v}<span class="cell-idx">[${i}]</span></div>`;
        }).join('');
    }
    function p2Run() {
        let maxV = data2[0], minV = data2[0], maxI = 0, minI = 0, i = 1;
        while(i < data2.length) {
            if (data2[i] > maxV) { maxV = data2[i]; maxI = i; }
            if (data2[i] < minV) { minV = data2[i]; minI = i; }
            i++;
        }
        render2(maxI, minI);
        document.getElementById('log2').innerHTML = `Max: <b>${maxV}</b> ([${maxI}]), Min: <b>${minV}</b> ([${minI}])`;
    }
    render2();

    // --- 3. PROJEKT LOGIKA ---
    const data3 = [12, 45, 23, 67, 89, 10, 34, 56];
    function render3() {
        document.getElementById('arr3').innerHTML = data3.map((v, i) => `<div class="cell">${v}<span class="cell-idx">[${i}]</span></div>`).join('');
    }
    function p3Run() {
        let th = parseInt(document.getElementById('th3').value) || 0;
        let sum = 0, count = 0, i = 0;
        while(i < data3.length) {
            sum += data3[i];
            if (data3[i] > th) count++;
            i++;
        }
        let avg = sum / data3.length;
        document.getElementById('log3').innerHTML = `Összeg: ${sum} | Átlag: ${avg.toFixed(1)} | Küszöb felett: ${count} db`;
    }
    render3(); p3Run();

    // --- 4. PROJEKT LOGIKA ---
    const orig4 = [1, 2, 3, 4, 5, 6, 7];
    let data4 = [...orig4];
    function render4() {
        document.getElementById('arr4').innerHTML = data4.map((v, i) => `<div class="cell">${v}<span class="cell-idx">[${i}]</span></div>`).join('');
    }
    function p4Run() {
        let l = 0, r = data4.length - 1;
        while (l < r) {
            let t = data4[l]; data4[l] = data4[r]; data4[r] = t;
            l++; r--;
        }
        render4();
        document.getElementById('log4').textContent = "Siker: A tömb megfordult.";
    }
    function p4Reset() { data4 = [...orig4]; render4(); document.getElementById('log4').textContent = "Alaphelyzet."; }
    render4();
</script>


</body></html>
